{
	"name": "tmurf",
	"version": "1.0.0",
	"description": "当 AI 完成工作时通知你 - 适配 Deepseek 聊天页面",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"postinstall": "wxt prepare",
		"lint": "biome lint .",
		"format": "biome format --write ."
	},
	"keywords": [
		"browser-extension",
		"wxt",
		"deepseek",
		"notification"
	],
	"author": "Chou Chiu, a2cheng",
	"license": "Apache-2.0",
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"typescript": "^6.0.3",
		"wxt": "^0.20.25"
	}
}
